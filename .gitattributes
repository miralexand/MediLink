# 统一换行符，避免 Windows/Linux 协作时的噪音
* text=auto

*.sh    text eol=lf
*.ps1   text eol=crlf
*.iss   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.toml  text eol=lf

*.exe   binary
*.msi   binary
*.png   binary
*.ico   binary
