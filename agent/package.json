{
  "name": "@medilink/agent",
  "version": "1.0.0",
  "description": "医联（MediLink）被控客户端（Windows）",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts run",
    "once": "bun run src/index.ts once",
    "status": "bun run src/index.ts status",
    "compile": "bun build --compile --minify --target=bun-windows-x64 src/index.ts --outfile dist/medilink-agent.exe",
    "typecheck": "bun x tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
