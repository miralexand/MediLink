{
  "name": "@medilink/console",
  "version": "1.0.0",
  "description": "MediLink 信息科控制端（Windows）",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "compile": "bun build --compile --minify --target=bun-windows-x64 src/index.ts --outfile dist/medilink-console.exe",
    "typecheck": "bun x tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
