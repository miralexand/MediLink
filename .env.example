# MediLink 服务端部署配置
# 复制为 .env 后按医院实际情况修改。切勿提交真实密钥到代码库。

# 服务器固定内网 IP（被控端/控制端据此连接）
RENDEZVOUS_SERVER=10.0.0.10:21116
RELAY_HOST=10.0.0.10

# 绑定的网卡地址。生产环境建议绑定内网 IP，限制仅内网访问。
HBBS_IP=0.0.0.0
MEDILINK_BIND_IP=0.0.0.0
MEDILINK_PORT=21120

# 管理控制台超级管理员（首次启动写入，之后请在控制台内修改口令）
MEDILINK_ADMIN_USER=admin
MEDILINK_ADMIN_PASSWORD=MediLink@2026

# 被控端注册密钥。留空表示不校验（仅建议内网测试）；生产务必设置为强随机串
MEDILINK_ENROLLMENT_KEY=

# RustDesk 服务端公钥（首次部署后从 data/rustdesk/id_ed25519.pub 读取，也可在控制台内填写）
MEDILINK_RUSTDESK_KEY=

# 安全策略
MEDILINK_REQUIRE_APPROVAL=true
MEDILINK_DEFAULT_READONLY=true
MEDILINK_AUDIT_RETENTION_DAYS=180

# 数据库字段级加密密钥（32 字节 base64）。留空则首次启动自动生成并存于数据库
# 生成方式：openssl rand -base64 32
MEDILINK_SECRET_KEY=
